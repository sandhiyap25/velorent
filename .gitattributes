# Normalize line endings for everyone, regardless of OS/editor config.
* text=auto eol=lf

# Windows-only scripts should stay CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Treat these as binary — never diff/merge them as text.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
