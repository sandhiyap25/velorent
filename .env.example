# VeloRent — Frontend Environment Configuration
#
# When running with XAMPP Apache + PHP + MySQL locally, set VITE_API_BASE_URL
# to the URL where you placed the `backend/api` folder inside `htdocs`:
#
# VITE_API_BASE_URL="http://localhost/OnlineVR/backend/api"
#
# Leave empty or set to "/api" when using a reverse proxy or the built-in dev server.
VITE_API_BASE_URL="http://localhost/OnlineVR/backend/api"
