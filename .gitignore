# --- Dependencies ---
node_modules/

# --- Build output ---
build/
dist/
dist-ssr/
coverage/
*.tsbuildinfo
.vite/

# --- Env files (never commit real secrets/local config) ---
.env
.env.local
.env.*.local
!.env.example

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- OS / editor junk ---
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/

# --- PHP backend runtime data ---
# Files people actually upload through the app land here at runtime
# (backend/api/uploads/upload.php writes to backend/uploads/). Keep the
# folder in git (see backend/uploads/.gitkeep) but never commit what
# users upload through it.
backend/uploads/*
!backend/uploads/.gitkeep
